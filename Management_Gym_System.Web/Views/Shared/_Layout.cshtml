<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Management</title>

    <!-- Core framework -->
    <link href="~/dist/libs/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="~/dist/libs/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/dist/webfont/tabler-icons.min.css" rel="stylesheet" />

    <!-- Vendor / plugin CSS -->
    @* <link href="~/dist/libs/toastr/toastr.min.css" rel="stylesheet" /> *@
    <link href="/dist/css/treeview.css" rel="stylesheet" />

    <!-- Tabler (UI framework, để trước Tom Select) -->
    <link href="/dist/css/tabler.min.css?1684106062" rel="stylesheet" />
    <link href="/dist/css/tabler-flags.min.css?1684106062" rel="stylesheet" />
    <link href="/dist/css/tabler-payments.min.css?1684106062" rel="stylesheet" />
    <link href="/dist/css/tabler-vendors.min.css?1684106062" rel="stylesheet" />

    <!-- QUAN TRỌNG: Tom Select để CUỐI -->
    <link href="~/dist/css/tom-select.css" rel="stylesheet" />
    <link href="/dist/css/Custom.css" rel="stylesheet" />
</head>

<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/">
                <i class="bi bi-activity text-warning me-2"></i>Gym Fit
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gymNavbar"
                    aria-controls="gymNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="gymNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="/"><i class="bi bi-house-door"></i> Tổng quan</a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link" href="/api/checkin" role="button" <i class="bi bi-person-badge"></i>Check-in
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-box-seam"></i> Quản lý danh mục
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/api/users">Users</a></li>
                            <li><a class="dropdown-item" href="/api/roles">Loại users</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="/api/product-categories">Loại sản phẩm</a></li>
                            <li><a class="dropdown-item" href="/api/products">Sản phẩm & Dịch vụ</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="/GymMembershipCard">Thẻ thành viên</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-wallet2"></i> Quản lý vận hành
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/inventory/export">Bán hàng</a></li>
                            <li><a class="dropdown-item" href="/finance/financials">Tài chính</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="/api/inventory/import">Nhập kho</a></li>
                            <li><a class="dropdown-item" href="/inventory/export">Kho vận</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-wallet2"></i> Báo cáo
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Báo cáo 1</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="#">Báo cáo 2</a></li>
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-wallet2"></i> Hệ thống
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">Phân quyền</a></li>
                            <li><a class="dropdown-item" href="#">Tài khoản</a></li>
                            <li><a class="dropdown-item" href="#">Tiện tích</a></li>
                        </ul>
                    </li>
                </ul>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-5"></i> Admin
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/profile">Trang cá nhân</a></li>
                            <li><a class="dropdown-item text-danger" href="/logout"><i
                                class="bi bi-box-arrow-right"></i> Đăng xuất</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container-fluid mt-4 mb-5">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <!-- Modal: Xác nhận xóa thẻ -->
        <div class="modal fade" id="modal-delete-confirm" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-body text-center py-4">
                        <i class="ti ti-trash text-danger" style="font-size: 3rem;"></i>
                        <h3 class="mt-3">Xác nhận xóa</h3>
                        <div class="text-muted">Bạn có chắc chắn muốn xóa? Dữ liệu không thể phục hồi.</div>
                        <input type="hidden" id="deleteCardId" />
                    </div>
                    <div class="modal-footer">
                        <div class="w-100">
                            <div class="row">
                                <div class="col"><a href="#" class="btn w-100" data-bs-dismiss="modal">Hủy</a></div>
                                <div class="col"><button type="button" class="btn btn-danger w-100"
                                                             onclick="submitDelete()">Xóa thẻ</button></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Modal HTML thông tin chỉ có mỗi Ok để xác nhận -->
            <div id="modal-overlay" style="display:none; position:fixed; inset:0;
                background:rgba(0,0,0,0.45); align-items:center; justify-content:center; z-index:9999;">
                <div style="background:#fff; border-radius:12px; width:360px; overflow:hidden;">

                    <div id="modal-header" class="bg-warning" style="padding:14px 16px;
                        display:flex; align-items:center; justify-content:space-between;">
                        <span id="modal-title" style="font-size:15px; font-weight:600; color:#fff;"></span>
                        <button onclick="DongModal()" class="btn-close btn-close-white"></button>
                    </div>

                    <div style="padding:24px 16px 20px; text-align:center;">
                        <i id="modal-icon" class="bi bi-info-circle-fill" style="font-size:48px; color:#ffc107;"></i>
                        <div class="d-flex justify-content-center mt-3">
                            <button onclick="DongModal()" class="btn btn-secondary px-4">OK</button>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Modal HTML xác nhận có 2 lựa chọn: Hủy hoặc Xác nhận -->
            <div id="modal-xn-overlay" style="display:none; position:fixed; inset:0;
                background:rgba(0,0,0,0.45); align-items:center; justify-content:center; z-index:9999;">
                <div style="background:#fff; border-radius:12px; width:360px; overflow:hidden;">

                    <div id="modal-xn-header" class="bg-warning" style="padding:14px 16px;
                        display:flex; align-items:center; justify-content:space-between;">
                        <span id="modal-xn-title" style="font-size:15px; font-weight:600; color:#fff;"></span>
                        <button onclick="DongModalXacNhan()" class="btn-close btn-close-white"></button>
                    </div>

                    <div style="padding:24px 16px 20px; text-align:center;">
                        <i id="modal-xn-icon" class="bi bi-question-circle-fill" style="font-size:48px; color:#ffc107;"></i>
                        <div class="d-flex justify-content-center gap-2 mt-3">
                            <button onclick="DongModalXacNhan()" class="btn btn-secondary px-4">Đóng</button>
                            <button onclick="XacNhanModal()" id="modal-xn-confirm" class="btn btn-warning px-4">Xác
                                nhận</button>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Toast container -->
                <div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3"></div>

                <script src="~/dist/libs/jquery/jquery.min.js"></script>
                <script src="~/dist/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                @* <script src="~/dist/libs/toastr/toastr.min.js"></script> *@
                <script src="/dist/libs/tom-select/dist/js/tom-select.base.js"></script>
                <script src="~/dist/js/Common.js"></script>

                @await RenderSectionAsync("Scripts", required: false)
            </body>

        </html>