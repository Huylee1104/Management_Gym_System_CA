<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Management</title>

    <!-- Core framework -->
    <link href="~/dist/libs/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="~/dist/libs/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/dist/webfont/tabler-icons.min.css" rel="stylesheet" />

    <!-- Vendor / plugin CSS -->
    @* <link href="~/dist/libs/toastr/toastr.min.css" rel="stylesheet" /> *@
    <link href="/dist/css/treeview.css" rel="stylesheet" />

    <!-- Tabler (UI framework, để trước Tom Select) -->
    <link href="/dist/css/tabler.min.css?1684106062" rel="stylesheet" />
    <link href="/dist/css/tabler-flags.min.css?1684106062" rel="stylesheet" />
    <link href="/dist/css/tabler-payments.min.css?1684106062" rel="stylesheet" />
    <link href="/dist/css/tabler-vendors.min.css?1684106062" rel="stylesheet" />

    <!-- QUAN TRỌNG: Tom Select để CUỐI -->
    <link href="~/dist/css/tom-select.css" rel="stylesheet" />
    <link href="/dist/css/Custom.css" rel="stylesheet" />
</head>
<style>
    .dropdown-item {
        font-weight: 600;
        padding: .65rem 1rem;
    }

    .dropdown-item i {
        width: 20px;
        text-align: center;
    }
</style>
<body class="bg-light">

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();

        string Active(params string[] controllers) =>
            controllers.Contains(currentController, StringComparer.OrdinalIgnoreCase) ? "active" : "";

        bool KhoiQuanLyHeThong = User.HasClaim("Permission", "USER_VIEW")
                    || User.HasClaim("Permission", "ROLE_VIEW")
                    || User.HasClaim("Permission", "PERMISSION_VIEW")
                    || User.HasClaim("Permission", "AUDITLOG_VIEW");

        bool KhoiQuanLyDanhMuc = User.HasClaim("Permission", "PRODUCTCATEGORY_VIEW")
                    || User.HasClaim("Permission", "PRODUCT_VIEW")
                    || User.HasClaim("Permission", "GYMMEMBERSHIPCARD_VIEW");

        bool QuanLyVanHanh = User.HasClaim("Permission", "INVENTORY_VIEW")
                    || User.HasClaim("Permission", "FINANCE_VIEW")
                    || User.HasClaim("Permission", "INVENTORYIMPORT_VIEW");

        bool isAdmin = KhoiQuanLyHeThong || KhoiQuanLyDanhMuc || QuanLyVanHanh;
        bool isMember = User.HasClaim("Permission", "NO_ACTION");
    }

    <nav class="navbar navbar-expand-lg @(isAdmin ? "navbar-dark bg-dark" : "navbar-light") shadow-sm sticky-top" 
        style="@(isAdmin ? "" : "background-color: #f0b55d;")">
        <div class="container-fluid">

            <a class="navbar-brand fw-bold">
                <i class="bi bi-activity text-red me-2"></i>Gym Fit
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gymNavbar"
                    aria-controls="gymNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="gymNavbar">

                <!-- Menu bên trái -->
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (!KhoiQuanLyHeThong && !KhoiQuanLyDanhMuc && !QuanLyVanHanh)
                    {
                        <li class="nav-item">
                            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill me-1"></i>
                                Trang chủ
                            </a>
                        </li>

                        if (!isMember)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("About")" asp-controller="Home" asp-action="About">
                                    <i class="bi bi-info-circle-fill me-1"></i>
                                    Giới thiệu
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @Active("About")" asp-controller="Home" asp-action="About">
                                    <i class="bi bi-pencil-square me-1"></i>
                                    Đăng ký ngay
                                </a>
                            </li>
                        }

                        @if (isMember)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("About")" asp-controller="Home" asp-action="IndexMember">
                                    <i class="bi bi-card-checklist me-1"></i>
                                    Quản lý gói tập
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @Active("Workout")"
                                href="#"
                                role="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                                    <i class="bi bi-fire me-1"></i>
                                    Tập luyện
                                </a>

                                <ul class="dropdown-menu shadow">

                                    <li>
                                        <a class="dropdown-item fw-semibold" href="#">
                                            <i class="bi bi-chevron-double-up me-3 text-primary"></i>
                                            Vai
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item fw-semibold" href="#">
                                            <i class="bi bi-grid-3x3-gap-fill me-3 text-success"></i>
                                            Lưng
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item fw-semibold" href="#">
                                            <i class="bi bi-hexagon-fill me-3 text-danger"></i>
                                            Ngực
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item fw-semibold" href="#">
                                            <i class="bi bi-record-circle-fill me-3 text-warning"></i>
                                            Tay
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item fw-semibold" href="#">
                                            <i class="bi bi-bullseye me-3 text-info"></i>
                                            Bụng
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item fw-semibold" href="#">
                                            <i class="bi bi-triangle-fill me-3 text-secondary"></i>
                                            Chân
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item fw-semibold" href="#">
                                            <i class="bi bi-lightning-charge-fill me-3 text-warning"></i>
                                            Giảm mỡ
                                        </a>
                                    </li>

                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @Active("Nutrition")" asp-controller="Nutrition" asp-action="Index">
                                    <i class="bi bi-egg-fried me-1"></i>
                                    Dinh dưỡng
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link @Active("News")" asp-controller="News" asp-action="Index">
                                <i class="bi bi-newspaper me-1"></i>
                                Tin tức
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @Active("Contact")" asp-controller="Contact" asp-action="Index">
                                <i class="bi bi-telephone-fill me-1"></i>
                                Liên hệ
                            </a>
                        </li>
                    }

                    @if (isAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="IndexAdmin">
                                <i class="bi bi-house-door-fill me-1"></i>
                                Quản lý chung
                            </a>
                        </li>
                    }
                    @if (User.HasClaim("Permission", "CHECKIN_VIEW"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @Active("CheckIn")" asp-controller="CheckIn" asp-action="Index">
                                <i class="bi bi-person-badge"></i> Check-in
                            </a>
                        </li>
                    }

                    @if (KhoiQuanLyDanhMuc)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @Active("ProductCategory", "Product", "GymMembershipCard")"
                            href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-box-seam"></i> Quản lý danh mục
                            </a>
                            <ul class="dropdown-menu">
                                @if (User.HasClaim("Permission", "PRODUCTCATEGORY_VIEW"))
                                {
                                    <li><a class="dropdown-item" asp-controller="ProductCategory" asp-action="Index">Loại sản phẩm</a></li>
                                }
                                @if (User.HasClaim("Permission", "PRODUCT_VIEW"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index">Sản phẩm &amp; Dịch vụ</a></li>
                                }
                                @if (User.HasClaim("Permission", "GYMMEMBERSHIP_VIEW"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="GymMembershipCard" asp-action="Index">Thẻ thành viên</a></li>
                                }
                            </ul>
                        </li>
                    }
                    
                    @if (QuanLyVanHanh)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @Active("Inventory", "Finance", "InventoryImport")"
                            href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-wallet2"></i> Quản lý vận hành
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Export">Bán hàng</a></li>
                                <li><a class="dropdown-item" asp-controller="Finance" asp-action="Index">Tài chính</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="InventoryImport" asp-action="Index">Nhập kho</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <!-- Menu bên phải -->
                <ul class="navbar-nav ms-auto">

                    @if (KhoiQuanLyHeThong)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-shield-lock"></i> Quản trị hệ thống
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.HasClaim("Permission", "USER_VIEW"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="User" asp-action="Index">
                                            <i class="bi bi-people me-2"></i>Người dùng
                                        </a>
                                    </li>
                                }
                                @if (User.HasClaim("Permission", "ROLE_VIEW"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Role" asp-action="Index">
                                            <i class="bi bi-person-badge me-2"></i>Quản lý vai trò
                                        </a>
                                    </li>
                                }
                                @if (User.HasClaim("Permission", "PERMISSION_VIEW"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="Permission" asp-action="Index">
                                            <i class="bi bi-shield-check me-2"></i>Quản lý chức năng
                                        </a>
                                    </li>
                                }
                                @if (User.HasClaim("Permission", "AUDITLOG_VIEW"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="AuditLog" asp-action="Index">
                                            <i class="bi bi-clock-history me-2"></i>Nhật ký hoạt động
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle fs-5 text-warning me-1"></i>
                                @(User.FindFirst("FullName")?.Value ?? User.Identity.Name)
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person me-2"></i>Trang cá nhân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger w-100 text-start">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                            </a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Modal Xác nhận xóa -->
    <div class="modal fade" id="modal-delete-confirm" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <i class="bi bi-trash3 text-danger" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">Xác nhận xóa</h4>
                    <div class="text-muted small">
                        Bạn có chắc chắn muốn xóa? Dữ liệu không thể phục hồi.

                    </div>
                    <input type="hidden" id="deleteCardId" />
                </div>
                <div class="modal-footer">
                    <div class="w-100">
                        <div class="row g-2">
                            <div class="col"><button type="button" class="btn btn-light w-100 border"
                                                         data-bs-dismiss="modal">Hủy</button>
                            </div>
                            <div class="col"><button type="button" class="btn btn-danger w-100"
                                                         onclick="submitDelete()">Xóa</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Thông Tin -->
    <div id="modal-overlay" style="display:none;
        position:fixed;
        inset:0;
        background:rgba(0,0,0,.5);
        justify-content:center;
        align-items:center;
        z-index:9999;">

        <div class="card shadow-lg" style="width:420px;max-width:95%;">

            <div id="modal-header" class="card-header bg-warning text-white d-flex align-items-center">

                <i id="modal-icon" class="bi bi-info-circle-fill me-2" style="font-size:1.5rem;"></i>

                <h5 id="modal-title" class="mb-0">
                    Thông báo
                </h5>

            </div>

            <div class="card-body text-center py-4">

                <div class="text-muted">
                    Vui lòng đọc thông báo.
                </div>

            </div>

            <div class="card-footer text-end">
                <button class="btn btn-primary" onclick="DongModal()">
                    Đóng
                </button>
            </div>

        </div>

    </div>

    <!-- Modal Xác Nhận -->
    <div id="modal-xn-overlay" style="display:none;
        position:fixed;
        inset:0;
        background:rgba(0,0,0,.5);
        justify-content:center;
        align-items:center;
        z-index:9999;">

        <div class="card shadow-lg" style="width:420px;max-width:95%;">

            <div id="modal-xn-header" class="card-header bg-warning text-white d-flex align-items-center">

                <i id="modal-xn-icon" class="bi bi-question-circle-fill me-2" style="font-size:1.5rem;"></i>

                <h5 id="modal-xn-title" class="mb-0">
                    Xác nhận
                </h5>

            </div>

            <div class="card-body text-center py-4">

                <div class="text-muted">
                    Bạn có chắc chắn muốn tiếp tục?
                </div>

            </div>

            <div class="card-footer">
                <div class="row g-2">
                    <div class="col">
                        <button class="btn btn-light border w-100" onclick="DongModalXacNhan()">
                            Hủy
                        </button>
                    </div>

                    <div class="col">
                        <button id="modal-xn-confirm" class="btn btn-warning w-100" onclick="XacNhanModal()">
                            Đồng ý
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <div id="loadingOverlay" class="loading-overlay d-none">
        <div class="loading-content">
            <div class="spinner-border text-light mb-3" role="status"></div>
            <div id="loadingText">Đang tải dữ liệu...</div>
        </div>
    </div>

    <!-- Toast container -->
    <div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3"></div>

    <script src="~/dist/libs/jquery/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/dist/libs/tom-select/dist/js/tom-select.base.js"></script>
    <script src="~/dist/js/Common.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>