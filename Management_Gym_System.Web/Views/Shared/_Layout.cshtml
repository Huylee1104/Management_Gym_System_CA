<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gym Management</title>

    <!-- Core framework -->
    <link href="~/dist/libs/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="~/dist/libs/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/dist/webfont/tabler-icons.min.css" rel="stylesheet" />

    <!-- Vendor / plugin CSS -->
    @* <link href="~/dist/libs/toastr/toastr.min.css" rel="stylesheet" /> *@
    <link href="/dist/css/treeview.css" rel="stylesheet" />

    <!-- Tabler (UI framework, để trước Tom Select) -->
    <link href="/dist/css/tabler.min.css?1684106062" rel="stylesheet" />
    <link href="/dist/css/tabler-flags.min.css?1684106062" rel="stylesheet" />
    <link href="/dist/css/tabler-payments.min.css?1684106062" rel="stylesheet" />
    <link href="/dist/css/tabler-vendors.min.css?1684106062" rel="stylesheet" />

    <!-- QUAN TRỌNG: Tom Select để CUỐI -->
    <link href="~/dist/css/tom-select.css" rel="stylesheet" />
    <link href="/dist/css/Custom.css" rel="stylesheet" />
</head>

<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="bi bi-activity text-warning me-2"></i>Gym Fit
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gymNavbar"
                    aria-controls="gymNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="gymNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door"></i> Tổng quan
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="CheckIn" asp-action="Index">
                            <i class="bi bi-person-badge"></i> Check-in
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-box-seam"></i> Quản lý danh mục
                        </a>
                        <ul class="dropdown-menu">
                            @* <li><a class="dropdown-item" asp-controller="User" asp-action="Index">Users</a></li>
                            <li><a class="dropdown-item" asp-controller="Role" asp-action="Index">Loại users</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li> *@
                            <li><a class="dropdown-item" asp-controller="ProductCategory" asp-action="Index">Loại sản
                                phẩm</a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index">Sản phẩm & Dịch
                                    vụ</a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li><a class="dropdown-item" asp-controller="GymMembershipCard" asp-action="Index">Thẻ thành
                                        viên</a></li>
                                    </ul>
                                </li>

                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-wallet2"></i> Quản lý vận hành
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Export">Bán hàng</a>
                                        </li>
                                        <li><a class="dropdown-item" asp-controller="Finance" asp-action="Index">Tài chính</a></li>
                                        <li>
                                            <hr class="dropdown-divider">
                                        </li>
                                        <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Import">Nhập kho</a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>

                            @if (User.HasClaim(
                                "Permission",
                                "USER_VIEW")
                            || User.HasClaim(
                                "Permission",
                                "ROLE_VIEW")
                            || User.HasClaim(
                                "Permission",
                                "FUNCTION_VIEW"))
                            {
                                <li class="nav-item dropdown">

                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">

                                        <i class="bi bi-shield-lock"></i>
                                        Quản trị hệ thống

                                    </a>

                                    <ul class="dropdown-menu">

                                        @if (User.HasClaim(
                                                "Permission",
                                                "USER_VIEW"))
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="User" asp-action="Index">

                                                    <i class="bi bi-people me-2"></i>
                                                    Người dùng

                                                </a>
                                            </li>
                                        }

                                        @if (User.HasClaim(
                                                "Permission",
                                                "ROLE_VIEW"))
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Role" asp-action="Index">

                                                    <i class="bi bi-person-badge me-2"></i>
                                                    Vai trò

                                                </a>
                                            </li>
                                        }

                                        @if (User.HasClaim(
                                                "Permission",
                                                "FUNCTION_VIEW"))
                                        {
                                            <li>
                                                <a class="dropdown-item" asp-controller="Permission" asp-action="Index">

                                                    <i class="bi bi-shield-check me-2"></i>
                                                    Chức năng & phân quyền

                                                </a>
                                            </li>
                                        }

                                    </ul>

                                </li>
                            }

                            <ul class="navbar-nav ms-auto">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-person-circle fs-5 text-warning me-1"></i>
                                            @(User.FindFirst("FullName")?.Value ?? User.Identity.Name)
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                                    <i class="bi bi-person me-2"></i>Trang cá nhân
                                                </a>
                                            </li>
                                            <li>
                                                <hr class="dropdown-divider">
                                            </li>
                                            <li>
                                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="dropdown-item text-danger border-0 bg-transparent">
                                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </li>
                                }
                                else
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="Account" asp-action="Login">
                                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </nav>

                <div class="container-fluid mt-4 mb-5">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>

                <!-- Modal Xác nhận xóa -->
                <div class="modal fade" id="modal-delete-confirm" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-sm modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-body text-center py-4">
                                <i class="bi bi-trash3 text-danger" style="font-size: 3rem;"></i>
                                <h4 class="mt-3">Xác nhận xóa</h4>
                                <div class="text-muted small">Bạn có chắc chắn muốn xóa? Dữ liệu không thể phục hồi.</div>
                                <input type="hidden" id="deleteCardId" />
                            </div>
                            <div class="modal-footer">
                                <div class="w-100">
                                    <div class="row g-2">
                                        <div class="col"><button type="button" class="btn btn-light w-100 border"
                                                                     data-bs-dismiss="modal">Hủy</button></div>
                                            <div class="col"><button type="button" class="btn btn-danger w-100"
                                                                         onclick="submitDelete()">Xóa</button></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Toast container -->
                        <div id="toast-container" class="toast-container position-fixed top-0 end-0 p-3"></div>

                        <script src="~/dist/libs/jquery/jquery.min.js"></script>
                        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                        <script src="~/dist/js/Common.js"></script>
                        @await RenderSectionAsync("Scripts", required: false)
                    </body>

                </html>