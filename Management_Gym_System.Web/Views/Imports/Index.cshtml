@{
    ViewData["Title"] = "Quản lý Nhập kho";
}

<style>
    /* ===== TAB STYLES ===== */
    .import-tab-nav .nav-link {
        color: #6c757d;
        font-weight: 500;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 0.75rem 1.5rem;
        border-radius: 0;
        transition: all 0.2s;
    }

    .import-tab-nav .nav-link.active {
        color: #0d6efd;
        border-bottom: 3px solid #0d6efd;
        background: transparent;
    }

    .import-tab-nav .nav-link:hover:not(.active) {
        color: #0d6efd;
        background: #f0f4ff;
    }

    /* ===== CART TABLE ===== */
    #cartBody input[type="number"] {
        min-width: 70px;
    }

    .summary-bar {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1rem 1.5rem;
    }

    .summary-bar .summary-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 4px 0;
        font-size: 0.95rem;
    }

    .summary-bar .summary-item.total {
        border-top: 2px solid #dee2e6;
        margin-top: 8px;
        padding-top: 10px;
        font-size: 1.1rem;
        font-weight: 700;
        color: #dc3545;
    }

    /* ===== HISTORY FILTER ===== */
    .filter-sidebar {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 1.25rem;
    }

    .filter-sidebar .filter-label {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: 0.25rem;
    }

    .ts-dropdown {
        z-index: 1056 !important;
    }

    .cart-input-td {
        padding: 0 !important;
    }

    .cart-input-td input {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 38px;
        border: none;
        outline: none;
        background: transparent;
        padding: 4px 8px;
        box-sizing: border-box;
        margin: 0;
        font-size: 0.875rem;
    }

    .cart-input-td input:focus {
        background-color: #fff3cd;
    }
</style>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white pb-0 px-4">
        <ul class="nav import-tab-nav" id="importTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="tab-import" data-bs-toggle="tab" href="#tabImport" role="tab">
                    <i class="bi bi-box-arrow-in-down me-1"></i> Nhập kho
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="tab-history" data-bs-toggle="tab" href="#tabHistory" role="tab">
                    <i class="bi bi-clock-history me-1"></i> Lịch sử nhập kho
                </a>
            </li>
        </ul>
    </div>

    <div class="card-body">
        <div class="tab-content" id="importTabContent">

            <!-- ==================== TAB 1: NHẬP KHO ==================== -->
            <div class="tab-pane fade show active" id="tabImport" role="tabpanel">

                <!-- Hàng 1: Nhà cung cấp + chọn sản phẩm -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Nhà cung cấp <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="supplierName" placeholder="VD: Công ty TNHH ABC...">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Chọn sản phẩm</label>
                        <select id="productSelect" placeholder="Tìm theo tên sản phẩm..."></select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-primary w-100" onclick="addProductToCart()">
                            <i class="bi bi-plus-lg me-1"></i> Thêm vào
                        </button>
                    </div>
                </div>

                <!-- Bảng giỏ hàng -->
                <div class="table-responsive mb-3" style="max-height: 300px; overflow-y: auto;">
                    <table class="table table-bordered table-hover table-sm align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th width="35" class="text-center">STT</th>
                                <th>Sản phẩm</th>
                                <th width="120" class="text-center">Số lô</th>
                                <th width="140" class="text-center">Hạn dùng</th>
                                <th width="75" class="text-center"> Số lượng</th>
                                <th width="75" class="text-center"> ĐVT</th>
                                <th width="130" class="text-center">Đơn giá (đ)</th>
                                <th width="80" class="text-center">CK (%)</th>
                                <th width="115" class="text-center">Tiền CK (đ)</th>
                                <th width="80" class="text-center">VAT (%)</th>
                                <th width="115" class="text-center">Tiền VAT (đ)</th>
                                <th width="130" class="text-center fw-bold">Thành tiền (đ)</th>
                                <th width="45" class="text-center"></th>
                            </tr>
                        </thead>
                        <tbody id="cartBody">
                            <tr id="emptyCartRow">
                                <td colspan="12" class="text-center text-muted py-4">
                                    <i class="bi bi-cart-x fs-4 d-block mb-1"></i>
                                    Chưa có sản phẩm nào. Hãy chọn và thêm sản phẩm ở trên.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Thanh tổng kết + nút lưu -->
                <div class="mt-3">

                    <!-- Dòng 1 -->
                    <div class="row g-2 mb-2">

                        <div class="col-md-4">
                            <div
                                class="border rounded px-3 py-2 h-100 d-flex justify-content-between align-items-center">
                                <span class="text-muted">Thành tiền gốc</span>
                                <span id="lblSubTotal" class="fw-semibold">0 đ</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div
                                class="border rounded px-3 py-2 h-100 d-flex justify-content-between align-items-center">
                                <span class="text-success">Tổng chiết khấu</span>
                                <span id="lblDiscountTotal" class="fw-semibold text-success">0 đ</span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div
                                class="border rounded px-3 py-2 h-100 d-flex justify-content-between align-items-center">
                                <span class="text-warning">Tổng VAT</span>
                                <span id="lblTaxTotal" class="fw-semibold text-warning">0 đ</span>
                            </div>
                        </div>

                    </div>

                    <!-- Dòng 2 -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <!-- Tổng thanh toán -->
                        <div class="border rounded px-3 py-2">
                            <span class="fw-semibold me-3">
                                Tổng thanh toán:
                            </span>

                            <span id="lblFinalTotal" class="fw-bold text-danger fs-5">
                                0 đ
                            </span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button class="btn btn-outline-secondary" onclick="clearCart()">

                                <i class="bi bi-x-circle me-1"></i>
                                Huỷ phiếu

                            </button>

                            <button class="btn btn-success px-4" onclick="submitImport()">

                                <i class="bi bi-save me-1"></i>
                                Lưu phiếu nhập

                            </button>

                        </div>

                    </div>

                </div>
            </div>

            <!-- ==================== TAB 2: LỊCH SỬ NHẬP KHO ==================== -->
            <div class="tab-pane fade" id="tabHistory" role="tabpanel">
                <div class="row g-3">

                    <!-- Cột trái: Bộ lọc -->
                    <div class="col-lg-3 col-md-4">
                        <div class="filter-sidebar">
                            <h4 class="fw-bold mb-3">
                                <i class="bi bi-funnel me-1 text-primary"></i> Bộ lọc
                            </h4>

                            <div class="mb-3">
                                <div class="filter-label">Từ ngày</div>
                                <input type="date" class="form-control" id="filterFromDate">
                            </div>

                            <div class="mb-3">
                                <div class="filter-label">Đến ngày</div>
                                <input type="date" class="form-control" id="filterToDate">
                            </div>

                            <div class="mb-3">
                                <div class="filter-label">Sản phẩm</div>
                                <select id="filterProductSelect" placeholder="Chọn sản phẩm..."></select>
                            </div>

                            <div class="mb-4">
                                <div class="filter-label">Nhà cung cấp</div>
                                <input type="text" class="form-control" id="filterSupplier"
                                       placeholder="Tên nhà cung cấp...">
                            </div>

                            <button class="btn btn-outline-primary w-100 mb-2" onclick="applyHistoryFilter()">
                                <i class="bi bi-search me-1"></i> Lọc danh sách
                            </button>
                            <div class="row gap-2 p-2">
                                <button class="btn btn-outline-danger w-100" onclick="ExportPdfIncome()">
                                    <i class="bi bi-file-earmark-pdf me-1"></i> Export Pdf
                                </button>
                                <button class="btn btn-outline-success w-100" onclick="ExportExcelIncome()">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Cột phải: Bảng lịch sử -->
                    <div class="col-lg-9 col-md-8">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr class="text-center">
                                        <th>STT</th>
                                        <th>Số lô</th>
                                        <th>Ngày nhập</th>
                                        <th>Người nhập</th>
                                        <th>Nhà cung cấp</th>
                                        <th>Tổng tiền nhập</th>
                                        <th>Đã hủy</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody id="importHistoryTable">
                                    <tr>
                                        <td colspan="6" class="text-center text-muted py-4">
                                            Nhấn <strong>Tìm kiếm</strong> để tải dữ liệu.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Biến toàn cục
        let cart = [];
        let productsList = [];
        let tomSelectProduct = null;
        let tomSelectFilterProduct = null;
        let isHistoryLoaded = false;
    </script>
    <script src="~/dist/js/Import.js" asp-append-version="true"></script>
}
