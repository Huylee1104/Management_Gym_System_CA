<script>
    function initHome(){
        const root=document.querySelector('.home-page');
        if(!root)return;
        if(!('IntersectionObserver' in window)){return;}
        root.classList.add('js-ready');
        // Scroll reveal + stagger delay
        const io=new IntersectionObserver((es)=>es.forEach(e=>{
            if(!e.isIntersecting)return;
            e.target.style.setProperty('--d',(e.target.dataset.delay||0)+'ms');
            e.target.classList.add('show');
            e.target.querySelectorAll('.counter').forEach(countUp);
            io.unobserve(e.target);
        }),{threshold:.15});
        document.querySelectorAll('.reveal').forEach(el=>io.observe(el));

        // Đếm số trong 1.2s
        function countUp(el){
            const t=+el.dataset.target,d=1200,s=performance.now();
            (function f(n){const p=Math.min((n-s)/d,1),e=1-Math.pow(1-p,3);
            el.textContent=Math.round(t*e).toLocaleString('vi-VN');
            if(p<1)requestAnimationFrame(f);})(s);
        }

        // Form
        const form=document.getElementById('signupForm');
        form.addEventListener('submit',e=>{
            e.preventDefault();
            let ok=true;
            form.querySelectorAll('input').forEach(i=>{const v=i.checkValidity();i.classList.toggle('is-invalid',!v);if(!v)ok=false;});
            if(!ok)return;
            // TODO: gửi dữ liệu về server tại đây (fetch/axios)
            form.closest('.signup-card').classList.add('done');
        });
        }
        if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initHome);else initHome();
</script>