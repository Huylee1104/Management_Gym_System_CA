@{
    ViewData["Title"] = "Danh sách tư vấn";
}


<div class="row m-2">

    @* ===== BÊN TRÁI: bộ lọc ===== *@
    <div class="col-12 col-lg-2">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Bộ lọc</h3>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <label class="form-label" for="filterFromDate">Từ ngày</label>
                    <input type="date" id="filterFromDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="filterToDate">Đến ngày</label>
                    <input type="date" id="filterToDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")"/>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="filterStatus">Trạng thái</label>
                    <select id="filterStatus" class="form-select">
                        <option value="NotContacted" selected>Chưa liên lạc</option>
                        <option value="Contacted">Đã liên lạc</option>
                        <option value="Registered">Đã đăng ký</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="filterProduct">Gói tư vấn</label>
                    <select id="filterProduct" class="form-select">
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="filterStaff">Nhân viên tư vấn</label>
                    <select id="filterStaff" class="form-select">
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="filterKeyword">Tìm theo tên</label>
                    <input type="text" id="filterKeyword" class="form-control" placeholder="Nhập tên khách hàng" />
                </div>

                <div class="row g-2">
                    <div class="col-4">
                        <button type="button" id="btnLoadTuVan"
                                class="btn btn-outline-primary w-100 h-100 d-flex align-items-center justify-content-center">
                            <i class="ti ti-refresh"></i>
                        </button>
                    </div>

                    <div class="col-4">
                        <button type="button" id="btnExportPdfTuVan"
                                class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center">
                            <i class="ti ti-file-type-pdf me-1"></i>
                            PDF
                        </button>
                    </div>

                    <div class="col-4">
                        <button type="button" id="btnExportExcelTuVan"
                                class="btn btn-outline-success w-100 d-flex align-items-center justify-content-center">
                            <i class="ti ti-file-spreadsheet me-1"></i>
                            Excel
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    @* ===== BÊN PHẢI: bảng danh sách ===== *@
    <div class="col-12 col-lg-10">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Danh sách khách hàng</h3>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover text-nowrap">
                    <thead>
                        <tr>
                            <th>Ngày</th>
                            <th>Tên khách hàng</th>
                            <th>Số điện thoại</th>
                            <th>Email</th>
                            <th>Gói tư vấn</th>
                            <th>Ngày liên lạc gần nhất</th>
                            <th class="text-center">Số lần liên lạc</th>
                            <th class="text-center">Đã đăng ký gói</th>
                            <th>Người liên lạc</th>
                            <th class="w-1">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="adviseTableBody">
                        @* Dòng hiển thị khi chưa có dữ liệu *@
                        <tr id="adviseEmptyRow">
                            <td colspan="10" class="text-center text-muted py-4">Không có khách hàng nào</td>
                        </tr>

                    </tbody>
                </table>
            </div>

            <div class="card-footer d-flex align-items-center">
                @* TODO: phân trang *@
                <p id="adviseTotalText" class="m-0 text-muted">Tổng: 0 khách hàng</p>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/dist/js/MemberAdvise.js" asp-append-version="true" defer></script>
}