@{
    ViewData["Title"] = "Đăng ký gói tập";
}

<style>
    /* 1. Màu thương hiệu cho các class Bootstrap (xóa khối này nếu theme đã có màu cam) */
    #gymPackages .text-primary {
        color: var(--bs-primary) !important;
    }

    #gymPackages .border-primary {
        border-color: var(--bs-primary) !important;
    }

    #gymPackages .btn-primary {
        background: var(--bs-primary);
        border-color: var(--bs-primary);
        color: #fff;
    }

    #gymPackages .btn-primary:hover {
        background: var(--bs-primary-hover);
        border-color: var(--bs-primary-hover);
    }

    #gymPackages .btn-outline-primary {
        color: var(--bs-primary);
        border-color: var(--bs-primary);
    }

    #gymPackages .btn-outline-primary:hover {
        background: var(--bs-primary);
        color: #fff;
    }

    /* 2. Card nổi lên khi rê chuột (Bootstrap không có sẵn) */
    @@media (hover: hover) {
        #gymPackages .gp-card {
            transition: transform .25s, box-shadow .25s;
        }

        #gymPackages .gp-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .15) !important;
        }
    }
</style>

<div class="home-page" id="gymPackages">
    <div class="container-xl py-4">

        <div class="mb-4">
            <h1 class="h2 fw-bold mb-1">Đăng ký gói tập</h1>
            <p class="text-secondary mb-0">Chọn gói phù hợp với mục tiêu của bạn</p>
        </div>

        <div class="row g-4">
            <!-- Danh sách gói: laptop 4 cột, khi mở chi tiết thì còn 2 cột nằm bên trái -->
            <div class="col-12" id="gpListCol">
                <div class="row g-3 row-cols-1 row-cols-lg-4" id="gpList">
                    <div class="col-12 text-center text-secondary py-5">Đang tải gói tập...</div>
                </div>
            </div>

            <!-- Chi tiết gói (chỉ dùng trên laptop; trên điện thoại chi tiết nằm ngay dưới item) -->
            <div class="col-lg-6 d-none" id="gpSide">
                <div class="card border-0 shadow sticky-top overflow-y-auto" id="gpPanel"
                     style="top:1rem; max-height:calc(80vh - 2rem)"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="trialModal" tabindex="-1" aria-labelledby="trialModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 rounded-4">

            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body px-4 pb-4">

                <div class="text-center mb-4">
                    <h4 class="fw-bold mb-2">Đăng ký tập thử miễn phí</h4>
                    <p class="text-muted mb-0">
                        Để lại thông tin, chúng tôi sẽ liên hệ bạn sớm nhất.
                    </p>
                </div>

                <form>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Họ và tên
                        </label>
                        <input type="text" id="tvtfullName"
                               class="form-control form-control-lg"
                               placeholder="Nguyễn Văn A">
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Số điện thoại
                        </label>
                        <input type="tel" id="tvtphone"
                               class="form-control form-control-lg"
                               placeholder="0901234567">
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Email
                        </label>
                        <input type="email" id="tvtemail"
                               class="form-control form-control-lg"
                               placeholder="ban@email.com">
                    </div>

                    <button type="button" class="btn btn-warning w-100 py-3 fw-bold text-white" onclick="registerTrial()">
                        Đăng ký ngay
                    </button>

                </form>

            </div>

        </div>
    </div>
</div>

<div class="modal fade" id="paymentQrModal" tabindex="-1" aria-labelledby="paymentQrModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 rounded-4 shadow">

            <!-- Header có nút X ở góc phải phía trên để chủ động tắt Modal -->
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="paymentQrModalLabel">Thanh toán gói tập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>

            <div class="modal-body px-4 pb-4 text-center">
                <p class="text-secondary mb-1" id="qrPackageName">Gói tập</p>
                <h3 class="fw-bold text-primary mb-3" id="qrPaymentAmount">0đ</h3>

                <!-- Khung hiển thị mã QR -->
                <div class="d-inline-block p-3 bg-white border rounded-4 shadow-sm mb-3">
                    <div id="qrCodeContainer"></div>
                </div>

                <p class="text-muted mb-2" id="paymentStatusText">
                    Vui lòng mở ứng dụng ngân hàng và quét mã QR để thanh toán
                </p>

                <!-- Đồng hồ đếm ngược 5 phút -->
                <div class="badge bg-light text-dark border px-3 py-2 fs-6">
                    Thời gian còn lại: <span class="fw-bold text-danger" id="qrCountdownText">05:00</span>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isAuthenticated = @ViewBag.IsAuthenticated.ToString().ToLower();
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="~/dist/js/RegisterMembership.js" asp-append-version="true" defer></script>
}