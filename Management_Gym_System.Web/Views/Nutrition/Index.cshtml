@{
    ViewData["Title"] = "Kiến thức Dinh dưỡng";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<style>
    .home-page {
        --tblr-primary: #FF9800;
        --tblr-primary-rgb: 255, 152, 0;
        --tblr-primary-fg: #fff;
        --tblr-primary-lt: #FFF3E0;
        --brand-hover: #FB8C00;
        --brand-accent: #FF7043;
        background: var(--tblr-bg-surface-secondary);
        color: var(--tblr-body-color);
        overflow-x: clip;
        min-height: calc(100vh - 60px);
    }

    /* Thẻ tiêu đề đóng/mở bên trái */
    .nutrition-accordion-header {
        background-color: var(--tblr-primary);
        color: var(--tblr-primary-fg);
        border-radius: 50rem;
        padding: 0.75rem 1.25rem;
        cursor: pointer;
        transition: background-color 0.2s ease;
        user-select: none;
    }

    .nutrition-accordion-header:hover {
        background-color: var(--brand-hover);
    }

    .nutrition-accordion-header .chevron-icon {
        transition: transform 0.25s ease;
    }

    .nutrition-accordion-header.is-open .chevron-icon {
        transform: rotate(180deg);
    }

    /* Khung chứa danh sách item khi mở */
    .nutrition-list-wrapper {
        background-color: var(--tblr-primary-lt);
        border: 1px solid rgba(var(--tblr-primary-rgb), 0.25);
        border-radius: 1.25rem;
        padding: 0.75rem;
        max-height: 500px;
        overflow-y: auto;
    }

    /* Từng item bên trong danh sách */
    .nutrition-list-item {
        background-color: #ffffff;
        border: 1px solid rgba(var(--tblr-primary-rgb), 0.2);
        border-radius: 50rem;
        padding: 0.6rem 1.1rem;
        margin-bottom: 0.5rem;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .nutrition-list-item:last-child {
        margin-bottom: 0;
    }

    .nutrition-list-item:hover,
    .nutrition-list-item.active {
        background-color: var(--tblr-primary);
        color: var(--tblr-primary-fg);
        border-color: var(--brand-hover);
    }

    .nutrition-list-item.active .text-secondary {
        color: rgba(255, 255, 255, 0.85) !important;
    }

    .detail-image-box {
        max-height: 280px;
        object-fit: cover;
        border-radius: 1rem;
    }
</style>

<div class="page-wrapper home-page py-4">
    <div class="container-xl">
        <!-- Cờ lưu trạng thái Admin cho JS đọc -->
        <input type="hidden" id="isAdminFlag" value="@(isAdmin ? "true" : "false")" />

        <div class="row g-4">
            <!-- CỘT TRÁI: 2 THẺ ĐÓNG MỞ -->
            <div class="col-lg-4 col-md-5">
                
                <!-- THẺ 1: QUẢN LÝ NHÓM THỰC PHẨM -->
                <div class="mb-3">
                    <div id="headerGroups" class="nutrition-accordion-header is-open d-flex align-items-center justify-content-between shadow-sm" onclick="toggleAccordion('groups')">
                        <span class="fw-bold fs-3">Quản lý nhóm thực phẩm</span>
                        <div class="d-flex align-items-center gap-2">
                            @if (isAdmin)
                            {
                                <button type="button" class="btn btn-sm btn-light btn-icon rounded-circle" title="Thêm nhóm thực phẩm" onclick="openCreateGroupModal(event)">
                                    <!-- Dấu + -->
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M12 5l0 14" />
                                        <path d="M5 12l14 0" />
                                    </svg>
                                </button>
                            }
                            <span class="chevron-icon">▼</span>
                        </div>
                    </div>

                    <!-- Nội dung trải xuống của Nhóm thực phẩm (Mặc định mở) -->
                    <div id="panelGroups" class="nutrition-list-wrapper mt-2 shadow-sm">
                        <div id="groupListContainer">
                            <div class="text-center py-3 text-secondary">Đang tải nhóm thực phẩm...</div>
                        </div>
                    </div>
                </div>

                <!-- THẺ 2: QUẢN LÝ THỰC PHẨM -->
                <div class="mb-3">
                    <div id="headerDetails" class="nutrition-accordion-header d-flex align-items-center justify-content-between shadow-sm" onclick="toggleAccordion('details')">
                        <div>
                            <span class="fw-bold fs-3 d-block">Quản lý thực phẩm</span>
                            <small id="selectedGroupSubtitle" class="opacity-75">Chưa chọn nhóm</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (isAdmin)
                            {
                                <button type="button" class="btn btn-sm btn-light btn-icon rounded-circle" title="Thêm thực phẩm" onclick="openCreateDetailModal(event)">
                                    <!-- Dấu + -->
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                        <path d="M12 5l0 14" />
                                        <path d="M5 12l14 0" />
                                    </svg>
                                </button>
                            }
                            <span class="chevron-icon">▼</span>
                        </div>
                    </div>

                    <!-- Nội dung trải xuống của Thực phẩm (Mặc định đóng) -->
                    <div id="panelDetails" class="nutrition-list-wrapper mt-2 shadow-sm d-none">
                        <div id="detailListContainer">
                            <div class="text-center py-3 text-secondary">Vui lòng chọn một nhóm thực phẩm trước.</div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- CỘT PHẢI: NỘI DUNG PHÂN TÍCH CHI TIẾT -->
            <div class="col-lg-8 col-md-7">
                <div class="card rounded-4 shadow-sm h-100 border-2">
                    <div class="card-body p-4">

                        <!-- Trạng thái chưa chọn thực phẩm -->
                        <div id="detailEmptyState" class="empty py-5 my-5">
                            <div class="empty-img">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg text-primary" width="64" height="64" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M12 21a9 9 0 0 1 0 -18c4.97 0 9 3.582 9 8c0 1.06 -.474 2.078 -1.318 2.828c-.844 .75 -1.989 1.172 -3.182 1.172h-2.5a2 2 0 0 0 -1 3.75a1.3 1.3 0 0 1 -1 2.25" />
                                    <path d="M8.5 10.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                                    <path d="M12.5 7.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                                    <path d="M16.5 10.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                                </svg>
                            </div>
                            <p class="empty-title">Chưa có thực phẩm nào được chọn</p>
                            <p class="empty-subtitle text-secondary">
                                Hãy chọn một nhóm thực phẩm ở danh sách bên trái, sau đó bấm vào một thực phẩm cụ thể để xem phân tích dinh dưỡng.
                            </p>
                        </div>

                        <!-- Trạng thái hiển thị chi tiết thực phẩm -->
                        <div id="detailContentArea" class="d-none">
                            <!-- Ảnh thực phẩm ở trên cùng theo mẫu thiết kế -->
                            <div class="text-center mb-4">
                                <img id="viewDetailImage" src="https://placehold.co/600x320/FFF3E0/FF9800?text=Hinh+Anh+Thuc+Pham" alt="Ảnh thực phẩm" class="img-fluid detail-image-box shadow-sm" />
                            </div>

                            <!-- Tiêu đề & Khẩu phần -->
                            <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-3 mb-4">
                                <div>
                                    <span id="viewDetailGroupBadge" class="badge bg-primary-lt text-primary mb-2">Nhóm thực phẩm</span>
                                    <h1 id="viewDetailName" class="mb-0 fw-bold">Tên thực phẩm</h1>
                                </div>
                                <div class="text-end">
                                    <div class="text-secondary small">Khẩu phần tiêu chuẩn</div>
                                    <div id="viewDetailServing" class="fs-2 fw-bold text-primary">100 g</div>
                                </div>
                            </div>

                            <!-- Mô tả chung -->
                            <div class="mb-4">
                                <h3 class="card-title text-uppercase text-secondary fs-4">Mô tả thực phẩm</h3>
                                <p id="viewDetailDescription" class="text-body fs-3 mb-0"></p>
                            </div>

                            <!-- Bảng chỉ số Dinh dưỡng (Macro & Micro) -->
                            <h3 class="card-title text-uppercase text-secondary fs-4 mb-3">Thành phần dinh dưỡng</h3>
                            <div class="row g-3 mb-4">
                                <div class="col-6 col-sm-3">
                                    <div class="card card-sm bg-primary-lt border-0">
                                        <div class="card-body text-center">
                                            <div class="text-secondary small fw-medium">Calories</div>
                                            <div id="viewCalories" class="fs-2 fw-bold text-primary">0 kcal</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <div class="card card-sm">
                                        <div class="card-body text-center">
                                            <div class="text-secondary small fw-medium">Protein (Đạm)</div>
                                            <div id="viewProtein" class="fs-2 fw-bold">0 g</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <div class="card card-sm">
                                        <div class="card-body text-center">
                                            <div class="text-secondary small fw-medium">Carb (Tinh bột)</div>
                                            <div id="viewCarb" class="fs-2 fw-bold">0 g</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6 col-sm-3">
                                    <div class="card card-sm">
                                        <div class="card-body text-center">
                                            <div class="text-secondary small fw-medium">Fat (Chất béo)</div>
                                            <div id="viewFat" class="fs-2 fw-bold">0 g</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="card card-sm bg-surface-secondary">
                                        <div class="card-body text-center py-2">
                                            <div class="text-secondary small">Chất xơ (Fiber)</div>
                                            <div id="viewFiber" class="fw-bold">0 g</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="card card-sm bg-surface-secondary">
                                        <div class="card-body text-center py-2">
                                            <div class="text-secondary small">Đường (Sugar)</div>
                                            <div id="viewSugar" class="fw-bold">0 g</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="card card-sm bg-surface-secondary">
                                        <div class="card-body text-center py-2">
                                            <div class="text-secondary small">Muối (Sodium)</div>
                                            <div id="viewSodium" class="fw-bold">0 mg</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Khuyến nghị sử dụng -->
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 border bg-surface-secondary h-100">
                                        <div class="fw-bold mb-1 text-primary">Thời điểm khuyên dùng</div>
                                        <div id="viewRecommendedTime" class="text-body">Chưa cập nhật</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 rounded-3 border bg-surface-secondary h-100">
                                        <div class="fw-bold mb-1 text-primary">Đối tượng phù hợp</div>
                                        <div id="viewRecommendedTarget" class="text-body">Chưa cập nhật</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Ưu điểm & Nhược điểm / Lưu ý -->
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="alert alert-success mb-0 h-100">
                                        <h4 class="alert-title">Lợi ích / Ưu điểm (Pros)</h4>
                                        <div id="viewPros" class="text-secondary" style="white-space: pre-line;">Chưa cập nhật</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="alert alert-warning mb-0 h-100">
                                        <h4 class="alert-title">Lưu ý / Hạn chế (Cons)</h4>
                                        <div id="viewCons" class="text-secondary" style="white-space: pre-line;">Chưa cập nhật</div>
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (isAdmin)
{
    <!-- MODAL 1: THÊM / SỬA NHÓM THỰC PHẨM -->
    <div class="modal modal-blur fade" id="modalGroup" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalGroupTitle">Thêm nhóm thực phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formGroup" onsubmit="saveGroup(event)">
                    <div class="modal-body">
                        <input type="hidden" id="groupId" name="Id" value="0" />

                        <div class="mb-3">
                            <label class="form-label required">Tên nhóm thực phẩm</label>
                            <input type="text" class="form-control" id="groupName" name="Name" required placeholder="Ví dụ: Thực phẩm giàu Đạm, Rau củ..." />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Thứ tự sắp xếp</label>
                                <input type="number" class="form-control" id="groupSortOrder" name="SortOrder" value="1" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Trạng thái</label>
                                <select class="form-select" id="groupIsActive" name="IsActive">
                                    <option value="true">Hiển thị</option>
                                    <option value="false">Đang ẩn</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ảnh minh họa (Tải lên Cloudinary)</label>
                            <input type="file" class="form-control" id="groupImageFile" name="imageFile" accept="image/*" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea class="form-control" id="groupDescription" name="Description" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary ms-auto">Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 2: THÊM / SỬA THỰC PHẨM CHI TIẾT -->
    <div class="modal modal-blur fade" id="modalDetail" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDetailTitle">Thêm thực phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formDetail" onsubmit="saveDetail(event)">
                    <div class="modal-body">
                        <input type="hidden" id="detailId" name="Id" value="0" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label required">Thuộc nhóm thực phẩm</label>
                                <select class="form-select" id="detailGroupId" name="NutritionGroupId" required>
                                    <option value="">-- Chọn nhóm thực phẩm --</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label required">Tên thực phẩm</label>
                                <input type="text" class="form-control" id="detailName" name="Name" required placeholder="Ví dụ: Ức gà phi lê, Khoai lang..." />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Khối lượng khẩu phần</label>
                                <input type="number" step="0.01" class="form-control" id="detailServingSize" name="ServingSize" value="100" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Đơn vị tính</label>
                                <input type="text" class="form-control" id="detailServingUnit" name="ServingUnit" value="g" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Trạng thái xuất bản</label>
                                <select class="form-select" id="detailIsPublished" name="IsPublished">
                                    <option value="true">Xuất bản (Hiển thị)</option>
                                    <option value="false">Bản nháp (Ẩn)</option>
                                </select>
                            </div>
                        </div>

                        <hr class="my-3" />
                        <h4 class="mb-3 text-primary">Chỉ số dinh dưỡng trên mỗi khẩu phần</h4>

                        <div class="row">
                            <div class="col-md-3 col-6 mb-3">
                                <label class="form-label">Calories (kcal)</label>
                                <input type="number" step="0.01" class="form-control" id="detailCalories" name="Calories" value="0" />
                            </div>
                            <div class="col-md-3 col-6 mb-3">
                                <label class="form-label">Protein (g)</label>
                                <input type="number" step="0.01" class="form-control" id="detailProtein" name="Protein" value="0" />
                            </div>
                            <div class="col-md-3 col-6 mb-3">
                                <label class="form-label">Carb (g)</label>
                                <input type="number" step="0.01" class="form-control" id="detailCarb" name="Carb" value="0" />
                            </div>
                            <div class="col-md-3 col-6 mb-3">
                                <label class="form-label">Fat (g)</label>
                                <input type="number" step="0.01" class="form-control" id="detailFat" name="Fat" value="0" />
                            </div>
                            <div class="col-md-4 col-6 mb-3">
                                <label class="form-label">Chất xơ - Fiber (g)</label>
                                <input type="number" step="0.01" class="form-control" id="detailFiber" name="Fiber" value="0" />
                            </div>
                            <div class="col-md-4 col-6 mb-3">
                                <label class="form-label">Đường - Sugar (g)</label>
                                <input type="number" step="0.01" class="form-control" id="detailSugar" name="Sugar" value="0" />
                            </div>
                            <div class="col-md-4 col-12 mb-3">
                                <label class="form-label">Muối - Sodium (mg)</label>
                                <input type="number" step="0.01" class="form-control" id="detailSodium" name="Sodium" value="0" />
                            </div>
                        </div>

                        <hr class="my-3" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Thời điểm khuyên dùng</label>
                                <input type="text" class="form-control" id="detailRecommendedTime" name="RecommendedTime" placeholder="Ví dụ: Trước tập 1-2 tiếng, Bữa trưa..." />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Đối tượng phù hợp</label>
                                <input type="text" class="form-control" id="detailRecommendedTarget" name="RecommendedTarget" placeholder="Ví dụ: Người tăng cơ giảm mỡ..." />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Ưu điểm (Pros)</label>
                                <textarea class="form-control" id="detailPros" name="Pros" rows="3"></textarea>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Lưu ý / Hạn chế (Cons)</label>
                                <textarea class="form-control" id="detailCons" name="Cons" rows="3"></textarea>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ảnh thực phẩm (Tải lên Cloudinary)</label>
                            <input type="file" class="form-control" id="detailImageFile" name="imageFile" accept="image/*" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mô tả chi tiết</label>
                            <textarea class="form-control" id="detailDescription" name="Description" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary ms-auto">Lưu thực phẩm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~dist/js/nutrition.js"></script>
}