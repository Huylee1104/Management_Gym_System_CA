@{
    ViewData["Title"] = "Kiến thức Dinh dưỡng";
    bool isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
}

<style>
    .home-page {
        --tblr-primary: #FF9800;
        --tblr-primary-rgb: 255, 152, 0;
        --tblr-primary-fg: #fff;
        --tblr-primary-lt: #FFF3E0;
        --brand-hover: #FB8C00;
        --brand-accent: #FF7043;
        background: var(--tblr-bg-surface-secondary);
        color: var(--tblr-body-color);
        overflow-x: clip;
        min-height: calc(100vh - 60px);
    }

    /* Thẻ accordion bên trái */
    .nutrition-accordion-header {
        background-color: var(--tblr-primary);
        color: var(--tblr-primary-fg);
        border-radius: 50rem;
        padding: 0.85rem 1.35rem;
        cursor: pointer;
        transition: background-color 0.2s ease;
        user-select: none;
    }

    .nutrition-accordion-header:hover {
        background-color: var(--brand-hover);
    }

    .nutrition-accordion-header .chevron-icon {
        transition: transform 0.25s ease;
    }

    .nutrition-accordion-header.is-open .chevron-icon {
        transform: rotate(180deg);
    }

    /* Khung danh sách item cuộn */
    .nutrition-list-wrapper {
        background-color: var(--tblr-primary-lt);
        border: 1px solid rgba(var(--tblr-primary-rgb), 0.25);
        border-radius: 1.25rem;
        padding: 0.85rem;
        max-height: calc(100vh - 240px);
        overflow-y: auto;
    }

    /* Từng item thực phẩm/nhóm */
    .nutrition-list-item {
        background-color: #ffffff;
        border: 1px solid rgba(var(--tblr-primary-rgb), 0.2);
        border-radius: 50rem;
        padding: 0.75rem 1.25rem;
        margin-bottom: 0.5rem;
        cursor: pointer;
        font-size: 1rem;
        transition: all 0.15s ease;
    }

    .nutrition-list-item:last-child {
        margin-bottom: 0;
    }

    .nutrition-list-item:hover,
    .nutrition-list-item.active {
        background-color: var(--tblr-primary);
        color: var(--tblr-primary-fg);
        border-color: var(--brand-hover);
    }

    .nutrition-list-item.active .text-secondary {
        color: rgba(255, 255, 255, 0.85) !important;
    }

    /* Ảnh thực phẩm */
    .detail-image-box {
        width: 100%;
        max-height: 350px;
        min-height: 240px;
        object-fit: cover;
        border-radius: 1rem;
    }

    .sticky-sidebar {
        position: sticky;
        top: 1rem;
    }
</style>

<div class="page-wrapper home-page py-3">
    <!-- Mở rộng toàn bộ chiều ngang hai bên lề -->
    <div class="container-fluid px-lg-4 px-xl-5">
        <input type="hidden" id="isAdminFlag" value="@(isAdmin ? "true" : "false")" />

        <div class="row g-4">
            <!-- CỘT TRÁI: QUẢN LÝ DANH SÁCH -->
            <div class="col-lg-4 col-xl-3">
                <div class="sticky-sidebar">
                    <!-- THẺ 1: QUẢN LÝ NHÓM -->
                    <div class="mb-3">
                        <div id="headerGroups" class="nutrition-accordion-header is-open d-flex align-items-center justify-content-between shadow-sm" onclick="toggleAccordion('groups')">
                            <span class="fw-bold fs-3">Quản lý nhóm thực phẩm</span>
                            <div class="d-flex align-items-center gap-2">
                                @if (isAdmin)
                                {
                                    <button type="button" class="btn btn-sm btn-light btn-icon rounded-circle" title="Thêm nhóm thực phẩm" onclick="openCreateGroupModal(event)">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary" width="22" height="22" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"><path d="M12 5v14M5 12h14"/></svg>
                                    </button>
                                }
                                <span class="chevron-icon">▼</span>
                            </div>
                        </div>

                        <div id="panelGroups" class="nutrition-list-wrapper mt-2 shadow-sm">
                            <div id="groupListContainer">
                                <div class="text-center py-3 text-secondary">Đang tải nhóm thực phẩm...</div>
                            </div>
                        </div>
                    </div>

                    <!-- THẺ 2: QUẢN LÝ THỰC PHẨM -->
                    <div class="mb-3">
                        <div id="headerDetails" class="nutrition-accordion-header d-flex align-items-center justify-content-between shadow-sm" onclick="toggleAccordion('details')">
                            <div>
                                <span class="fw-bold fs-3 d-block">Quản lý thực phẩm</span>
                                <small id="selectedGroupSubtitle" class="opacity-75">Chưa chọn nhóm</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (isAdmin)
                                {
                                    <button type="button" class="btn btn-sm btn-light btn-icon rounded-circle" title="Thêm thực phẩm" onclick="openCreateDetailModal(event)">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary" width="22" height="22" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"><path d="M12 5v14M5 12h14"/></svg>
                                    </button>
                                }
                                <span class="chevron-icon">▼</span>
                            </div>
                        </div>

                        <div id="panelDetails" class="nutrition-list-wrapper mt-2 shadow-sm d-none">
                            <div id="detailListContainer">
                                <div class="text-center py-3 text-secondary">Vui lòng chọn một nhóm thực phẩm trước.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: CHI TIẾT THỰC PHẨM -->
            <div class="col-lg-8 col-xl-9">
                <div class="card rounded-3 shadow-sm border h-100">
                    <div class="card-body p-4 p-xl-5">

                        <!-- Trạng thái trống -->
                        <div id="detailEmptyState" class="empty py-5 my-5">
                            <div class="empty-img">
                                <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-lg text-primary" width="64" height="64" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" fill="none">
                                    <path d="M12 21a9 9 0 0 1 0 -18c4.97 0 9 3.582 9 8c0 1.06 -.474 2.078 -1.318 2.828c-.844 .75 -1.989 1.172 -3.182 1.172h-2.5a2 2 0 0 0 -1 3.75a1.3 1.3 0 0 1 -1 2.25" />
                                    <path d="M8.5 10.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                                    <path d="M12.5 7.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                                    <path d="M16.5 10.5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                                </svg>
                            </div>
                            <p class="empty-title fs-2">Chưa có thực phẩm nào được chọn</p>
                            <p class="empty-subtitle text-secondary fs-3">
                                Hãy chọn nhóm và một thực phẩm cụ thể ở cột bên trái để xem bảng dinh dưỡng.
                            </p>
                        </div>

                        <!-- Khung chi tiết bố cục 2 cột con -->
                        <div id="detailContentArea" class="d-none">
                            <div class="row g-4 g-xl-5">

                                <!-- CỘT CON TRÁI: ẢNH THỰC PHẨM & CỤM TÊN + KHẨU PHẦN -->
                                <div class="col-xl-5 col-lg-5">
                                    <img id="viewDetailImage" src="https://placehold.co/600x320/FFF3E0/FF9800?text=Hinh+Anh" alt="Ảnh thực phẩm" class="detail-image-box shadow-sm mb-3" />

                                    <!-- Cụm Tên và Khẩu phần chuyển xuống dưới ảnh -->
                                    <div class="pt-2">
                                        <span id="viewDetailGroupBadge" class="badge bg-primary-lt text-primary fs-4 px-3 py-2 mb-2">Nhóm</span>
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <h1 id="viewDetailName" class="mb-0 fw-bold display-6">Tên thực phẩm</h1>
                                            <div class="text-end">
                                                <div class="text-secondary small">Khẩu phần chuẩn</div>
                                                <div id="viewDetailServing" class="display-6 fw-bold text-primary">100 g</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- CỘT CON PHẢI: MÔ TẢ, THỜI ĐIỂM/ĐỐI TƯỢNG, DINH DƯỠNG & PROS/CONS -->
                                <div class="col-xl-7 col-lg-7">
                                    <!-- 1. Mô tả thực phẩm đưa lên trên cùng -->
                                    <div class="mb-4">
                                        <div class="text-uppercase text-secondary fw-bold fs-4 mb-2">Mô tả thực phẩm</div>
                                        <p id="viewDetailDescription" class="text-body fs-3 mb-0" style="line-height: 1.6;"></p>
                                    </div>

                                    <!-- 2. Thời điểm khuyên dùng & Đối tượng phù hợp chuyển sang phải -->
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <div class="p-3 rounded-3 border bg-surface-secondary shadow-sm h-100">
                                                <div class="fw-bold fs-4 text-primary mb-1">Thời điểm khuyên dùng</div>
                                                <div id="viewRecommendedTime" class="text-body fs-3">Chưa cập nhật</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-3 rounded-3 border bg-surface-secondary shadow-sm h-100">
                                                <div class="fw-bold fs-4 text-primary mb-1">Đối tượng phù hợp</div>
                                                <div id="viewRecommendedTarget" class="text-body fs-3">Chưa cập nhật</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 3. Thành phần dinh dưỡng -->
                                    <div class="text-uppercase text-secondary fw-bold fs-4 mb-3">Thành phần dinh dưỡng</div>
                                    <div class="row g-3 mb-4">
                                        <div class="col-3">
                                            <div class="card card-sm bg-primary-lt border-0 text-center py-3 shadow-none">
                                                <div class="text-secondary fw-medium fs-4">Calories</div>
                                                <div id="viewCalories" class="display-6 fw-bold text-primary">0 kcal</div>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="card card-sm text-center py-3 shadow-none">
                                                <div class="text-secondary fw-medium fs-4">Protein</div>
                                                <div id="viewProtein" class="display-6 fw-bold">0 g</div>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="card card-sm text-center py-3 shadow-none">
                                                <div class="text-secondary fw-medium fs-4">Carb</div>
                                                <div id="viewCarb" class="display-6 fw-bold">0 g</div>
                                            </div>
                                        </div>
                                        <div class="col-3">
                                            <div class="card card-sm text-center py-3 shadow-none">
                                                <div class="text-secondary fw-medium fs-4">Fat</div>
                                                <div id="viewFat" class="display-6 fw-bold">0 g</div>
                                            </div>
                                        </div>

                                        <div class="col-4">
                                            <div class="card card-sm bg-surface-secondary text-center py-2 shadow-none">
                                                <div class="text-secondary fs-4">Chất xơ</div>
                                                <div id="viewFiber" class="fw-bold fs-2">0 g</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="card card-sm bg-surface-secondary text-center py-2 shadow-none">
                                                <div class="text-secondary fs-4">Đường</div>
                                                <div id="viewSugar" class="fw-bold fs-2">0 g</div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="card card-sm bg-surface-secondary text-center py-2 shadow-none">
                                                <div class="text-secondary fs-4">Muối</div>
                                                <div id="viewSodium" class="fw-bold fs-2">0 mg</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 4. Ưu điểm & Nhược điểm -->
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="alert alert-success mb-0 p-3 h-100">
                                                <div class="alert-title fs-4 fw-bold mb-2">Ưu điểm (Pros)</div>
                                                <div id="viewPros" class="text-secondary fs-4" style="white-space: pre-line;">Chưa cập nhật</div>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="alert alert-warning mb-0 p-3 h-100">
                                                <div class="alert-title fs-4 fw-bold mb-2">Lưu ý (Cons)</div>
                                                <div id="viewCons" class="text-secondary fs-4" style="white-space: pre-line;">Chưa cập nhật</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@if (isAdmin)
{
    <!-- MODAL 1: THÊM / SỬA NHÓM THỰC PHẨM -->
    <div class="modal modal-blur fade" id="modalGroup" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalGroupTitle">Thêm nhóm thực phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="formGroup" onsubmit="saveGroup(event)">
                    <div class="modal-body">
                        <input type="hidden" id="groupId" name="Id" value="0" />

                        <div class="mb-3">
                            <label class="form-label required">Tên nhóm thực phẩm</label>
                            <input type="text" class="form-control" id="groupName" name="Name" required placeholder="Ví dụ: Thực phẩm giàu Đạm, Rau củ..." />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Thứ tự sắp xếp</label>
                                <input type="number" class="form-control" id="groupSortOrder" name="SortOrder" value="1" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Trạng thái</label>
                                <select class="form-select" id="groupIsActive" name="IsActive">
                                    <option value="true">Hiển thị</option>
                                    <option value="false">Đang ẩn</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ảnh minh họa (Tải lên Cloudinary)</label>
                            <input type="file" class="form-control" id="groupImageFile" name="imageFile" accept="image/*" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mô tả</label>
                            <textarea class="form-control" id="groupDescription" name="Description" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary ms-auto">Lưu thông tin</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL 2: THÊM / SỬA THỰC PHẨM CHI TIẾT -->
    <div class="modal modal-blur fade" id="modalDetail" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable" role="document">
            <form class="modal-content" id="formDetail" onsubmit="saveDetail(event)">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDetailTitle">Thêm thực phẩm</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="detailId" name="Id" value="0" />

                    <!-- DÒNG 1: 5 phần tử thông tin cơ bản trên 1 hàng -->
                    <div class="row g-2 mb-3">
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label required">Thuộc nhóm thực phẩm</label>
                            <select class="form-select" id="detailGroupId" name="NutritionGroupId" required>
                                <option value="">-- Chọn nhóm thực phẩm --</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label required">Tên thực phẩm</label>
                            <input type="text" class="form-control" id="detailName" name="Name" required placeholder="Ví dụ: Ức gà phi lê..." />
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <label class="form-label">Khối lượng</label>
                            <input type="number" step="0.01" class="form-control" id="detailServingSize" name="ServingSize" value="100" required />
                        </div>
                        <div class="col-lg-2 col-md-4 col-6">
                            <label class="form-label">Đơn vị tính</label>
                            <input type="text" class="form-control" id="detailServingUnit" name="ServingUnit" value="g" required />
                        </div>
                        <div class="col-lg-2 col-md-4">
                            <label class="form-label">Trạng thái xuất bản</label>
                            <select class="form-select" id="detailIsPublished" name="IsPublished">
                                <option value="true">Xuất bản (Hiển thị)</option>
                                <option value="false">Bản nháp (Ẩn)</option>
                            </select>
                        </div>
                    </div>

                    <hr class="my-3" />
                    <h4 class="mb-2 text-primary">Chỉ số dinh dưỡng trên mỗi khẩu phần</h4>

                    <!-- DÒNG 2: 7 chỉ số chia đều trên 1 hàng ngang bằng class col-lg của Tabler -->
                    <div class="row g-2 mb-3">
                        <div class="col-lg col-md-3 col-6">
                            <label class="form-label text-nowrap">Calories (kcal)</label>
                            <input type="number" step="0.01" class="form-control" id="detailCalories" name="Calories" value="0" />
                        </div>
                        <div class="col-lg col-md-3 col-6">
                            <label class="form-label text-nowrap">Protein (g)</label>
                            <input type="number" step="0.01" class="form-control" id="detailProtein" name="Protein" value="0" />
                        </div>
                        <div class="col-lg col-md-3 col-6">
                            <label class="form-label text-nowrap">Carb (g)</label>
                            <input type="number" step="0.01" class="form-control" id="detailCarb" name="Carb" value="0" />
                        </div>
                        <div class="col-lg col-md-3 col-6">
                            <label class="form-label text-nowrap">Fat (g)</label>
                            <input type="number" step="0.01" class="form-control" id="detailFat" name="Fat" value="0" />
                        </div>
                        <div class="col-lg col-md-4 col-6">
                            <label class="form-label text-nowrap">Chất xơ (g)</label>
                            <input type="number" step="0.01" class="form-control" id="detailFiber" name="Fiber" value="0" />
                        </div>
                        <div class="col-lg col-md-4 col-6">
                            <label class="form-label text-nowrap">Đường (g)</label>
                            <input type="number" step="0.01" class="form-control" id="detailSugar" name="Sugar" value="0" />
                        </div>
                        <div class="col-lg col-md-4 col-12">
                            <label class="form-label text-nowrap">Muối (mg)</label>
                            <input type="number" step="0.01" class="form-control" id="detailSodium" name="Sodium" value="0" />
                        </div>
                    </div>

                    <hr class="my-3" />

                    <!-- DÒNG 3: Thời điểm, Đối tượng & Ảnh thực phẩm (3 phần tử trên 1 hàng) -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Thời điểm khuyên dùng</label>
                            <input type="text" class="form-control" id="detailRecommendedTime" name="RecommendedTime" placeholder="Ví dụ: Trước tập 1-2 tiếng..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Đối tượng phù hợp</label>
                            <input type="text" class="form-control" id="detailRecommendedTarget" name="RecommendedTarget" placeholder="Ví dụ: Người tăng cơ giảm mỡ..." />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ảnh thực phẩm (Cloudinary)</label>
                            <input type="file" class="form-control" id="detailImageFile" name="imageFile" accept="image/*" />
                        </div>
                    </div>

                    <!-- DÒNG 4: Ưu điểm, Hạn chế & Mô tả chi tiết (3 phần tử trên 1 hàng) -->
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Ưu điểm (Pros)</label>
                            <textarea class="form-control" id="detailPros" name="Pros" rows="3"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Lưu ý / Hạn chế (Cons)</label>
                            <textarea class="form-control" id="detailCons" name="Cons" rows="3"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Mô tả chi tiết</label>
                            <textarea class="form-control" id="detailDescription" name="Description" rows="3"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-link link-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary ms-auto">Lưu thực phẩm</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/dist/js/Nutrition.js" asp-append-version="true" defer></script>
}