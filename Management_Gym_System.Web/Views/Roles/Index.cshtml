@{
    ViewData["Title"] = "Quản lý Vai trò";
}

<style>

    .role-item {
        padding: 14px;
        margin: 4px;
        border-radius: 10px;
        cursor: pointer;
        transition: all .15s ease;
        border: 1px solid transparent;
    }

    .role-item:hover {
        background-color: #f5f7fa;
    }

    .role-item.active {
        background-color: #e9f2ff;
        border-color: #b6d4fe;
    }

    .role-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #eef4ff;
        color: #0d6efd;
        font-size: 18px;
    }

    .permission-function {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
    }

    .function-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        background-color: #f8f9fa;
    }

    .function-actions {
        padding: 8px 16px 10px 42px;
    }

    .action-item {
        padding: 7px 0;
    }

    .permission-count {
        font-size: 13px;
        color: #6c757d;
        font-weight: 500;
    }

    #roleList {
        max-height: calc(100vh - 260px);
        overflow-y: auto;
    }

    #permissionContainer {
        max-height: calc(100vh - 260px);
        overflow-y: auto;
    }

</style>

<div class="row g-3">

    <!-- =========================
         LEFT: QUẢN LÝ VAI TRÒ
         ========================= -->
    <div class="col-lg-5">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div class="input-group gap-2"
                         style="width: 300px;">

                        <input type="text"
                               id="txtSearch"
                               class="form-control"
                               placeholder="Tìm kiếm...">

                        <button type="button"
                                class="btn btn-outline-primary"
                                onclick="loadData()"
                                title="Tìm kiếm">

                            <i class="ti ti-search"></i>

                        </button>

                    </div>

                    <button type="button"
                            class="btn btn-primary"
                            onclick="showModal()">

                        <i class="bi bi-plus-lg"></i>
                        Thêm mới

                    </button>

                </div>

            </div>


            <div class="card-body">

                <div class="table-responsive table-scrollable-cards">

                    <table class="table table-hover align-middle">

                        <thead class="text-center text-black">

                            <tr class="table-primary">

                                <th>ID</th>

                                <th>Tên vai trò</th>

                                <th>Trạng thái</th>

                                <th>Thao tác</th>

                            </tr>

                        </thead>

                        <tbody id="tableBody">

                            <!-- JS render role ở đây -->

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         RIGHT: PHÂN QUYỀN
         ========================= -->
    <div class="col-lg-7">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white py-3">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <h5 class="mb-1"
                            id="permissionTitle">

                            Phân quyền

                        </h5>

                        <small class="text-muted"
                               id="permissionSubtitle">

                            Chọn một vai trò để xem quyền

                        </small>

                    </div>

                    <button type="button"
                            id="btnSavePermissions"
                            class="btn btn-primary"
                            onclick="savePermissions()"
                            disabled>

                        <i class="bi bi-check-lg me-1"></i>

                        Lưu phân quyền

                    </button>

                </div>

            </div>


            <div class="card-body">

                <div id="permissionContainer">

                    <div class="text-center text-muted py-5">

                        <i class="bi bi-shield-lock fs-1"></i>

                        <div class="mt-3">

                            Chọn một vai trò bên trái
                            để xem và quản lý quyền.

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="modal fade" id="dataModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm Vai trò</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="roleId" value="0" />
                <div class="mb-3">
                    <label class="form-label">Tên vai trò <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="roleName" required />
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="roleStatus" checked>
                    <label class="form-check-label" for="roleStatus">Hoạt động</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="saveData()">Lưu dữ liệu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        //const apiUrl = '/Role';
    </script>
    <script src="~/dist/js/Role.js"></script>
}