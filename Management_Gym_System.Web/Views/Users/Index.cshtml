@{
    ViewData["Title"] = "Quản lý Người dùng";
}


<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <div class="input-group gap-2">
            <div style="width: 250px;">
                <select id="selectFilter" class="form-select">
                </select>
            </div>
            <input type="text" id="txtSearch" class="form-control" style="max-width: 300px;" placeholder="Tìm tên ...">
            <button type="button" class="btn btn-outline-primary" onclick="loadData()" title="Tìm kiếm">
                <i class="ti ti-search"></i>
            </button>
        </div>
        <button class="btn btn-primary" onclick="showModal()"><i class="bi bi-person-plus"></i> Thêm User</button>
    </div>
    <div class="card-body">
        <div class="table-responsive table-scrollable-cards">
            <table class="table table-hover align-middle">
                <thead class=" text-center text-black">
                    <tr class="table-primary">
                        <th>Avatar</th>
                        <th>Họ và Tên</th>
                        <th>Vai trò (ID)</th>
                        <th>Gói tập</th>
                        <th>SĐT</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="tableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="dataModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Thêm User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body row">
                <input type="hidden" id="userId" value="0" />
                <div class="col-md-4 text-center mb-3">
                    <img id="imgPreview" src="https://placehold.co/150" class="img-thumbnail rounded-circle mb-2"
                         style="width:150px; height:150px; object-fit:cover;" />
                    <input type="file" class="form-control form-control-sm" id="fileUpload" accept="image/*"
                           onchange="encodeImageFileAsURL(this)" />
                    <input type="hidden" id="imageBase64" />
                </div>
                <div class="col-md-8 row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Họ và Tên <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="fullName" required autocomplete="off"
                               placeholder="Nhập họ và tên" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Ngày sinh</label>
                        <input type="date" class="form-control" id="birthDate" autocomplete="off" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Giới tính</label>
                        <select class="form-select" id="gender">
                            <option value="0" selected>Chọn giới tính</option>
                            <option value="1">Nam</option>
                            <option value="2">Nữ</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input type="text" class="form-control" id="phone" required autocomplete="off"
                               placeholder="Nhập SĐT" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Vai trò <span class="text-danger">*</span></label>
                        <select id="roleId" class="form-select" placeholder="Chọn vai trò..."></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Gói tập</label>
                        <select id="planId" class="form-select" placeholder="Chọn gói tập..."></select>
                    </div>
                    <div class="col-md-6 mb-3 gap-3 d-flex align-items-end">
                        <input class="form-check-input" type="checkbox" id="isMember" checked>
                        <label class="form-check-label" for="isMember">Hội viên</label>
                    </div>
                    <div class="col-md-6 form-check form-switch ms-3">
                        <input class="form-check-input" type="checkbox" id="userStatus" checked>
                        <label class="form-check-label" for="userStatus">Hoạt động</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="saveData()">Lưu dữ liệu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const apiUrl = '/User'; // Giả định bạn có endpoint này
        const roleApiUrl = '/Role/listRoles'; // Endpoint để lấy danh sách vai trò
        const planApiUrl = '/Product/listProducts'; // Endpoint để lấy danh sách gói tập
        const modal = new bootstrap.Modal(document.getElementById('dataModal'));
        let tomSelectRole;
        let tomSelectProduct = null;
        let tomSelectFilter = null;
    </script>
    <script src="~/dist/js/User.js" asp-append-version="true"></script>
}